// Module 1 — Foundation: Auth, RBAC, Custom Field Engine, Admin Settings
//
// Design notes (see /docs/architecture/module-1-foundation.md for the full writeup):
// - `resource`/`entityType` fields below are deliberately plain strings, not Prisma enums.
//   Every later module (Job, Candidate, Application, ...) plugs into RBAC, custom fields,
//   and the audit log by registering a key in `src/lib/entity-registry.ts` — no migration
//   needed to grant a new module access to these cross-cutting engines.
// - `AuditLog.action` is a namespaced string ("candidate.created") for the same reason:
//   the set of actions grows every module; a closed enum would need a migration per module.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & RBAC
// ---------------------------------------------------------------------------

model User {
  id                    String    @id @default(cuid())
  name                  String
  email                 String    @unique
  passwordHash          String
  isActive              Boolean   @default(true)
  avatarUrl             String?
  lastLoginAt           DateTime?
  onboardingCompletedAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // One-level reporting line, not a full Team entity — the PRD's "Recruiting
  // Manager oversees a team's requisitions" (§8) is the only team concept
  // v1 needs. This is what PermissionScope.TEAM resolves against in
  // src/lib/authz/authorize.ts: a manager's TEAM grant covers their direct
  // reports' records. Revisit if a later module needs multi-level teams.
  managerId String?
  manager   User?   @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)

  directReports User[]               @relation("UserManager")
  roles         UserRole[]
  auditLogs     AuditLog[]
  customRecords CustomObjectRecord[]

  jobsCreated             Job[]                    @relation("JobCreatedBy")
  jobsAsPrimaryRecruiter  Job[]                    @relation("JobPrimaryRecruiter")
  jobRecruiterAssignments JobRecruiterAssignment[]
  jobStatusChangesActed   JobStatusChange[]
  jobApprovalsAs          JobApproval[]            @relation("JobApprovalApprover")

  candidatesCreated          Candidate[]          @relation("CandidateCreatedBy")
  candidateDocumentsUploaded CandidateDocument[]  @relation("CandidateDocumentUploadedBy")
  candidateNotesAuthored     CandidateNote[]      @relation("CandidateNoteAuthor")
  erasureRequestsRequested   DataErasureRequest[] @relation("DataErasureRequestedBy")
  erasureRequestsDecided     DataErasureRequest[] @relation("DataErasureDecidedBy")

  applicationsOwned          Application[]         @relation("ApplicationOwner")
  applicationsCreated        Application[]         @relation("ApplicationCreatedBy")
  applicationEventsActed     ApplicationEvent[]
  applicationEmailsRequested ApplicationEmailLog[]

  interviewsScheduled       Interview[]         @relation("InterviewScheduledBy")
  interviewPanelAssignments InterviewPanelist[]
  interviewFeedbackAuthored InterviewFeedback[] @relation("InterviewFeedbackInterviewer")

  offersCreated    Offer[]         @relation("OfferCreatedBy")
  offerApprovalsAs OfferApproval[] @relation("OfferApprovalApprover")

  handoffsInitiated    HandoffRecord[]          @relation("HandoffInitiatedBy")
  handoffsAcknowledged HandoffRecord[]          @relation("HandoffAcknowledgedBy")
  handoffAttemptsActed HandoffDeliveryAttempt[]

  communicationTemplatesCreated CommunicationTemplate[] @relation("CommunicationTemplateCreatedBy")

  communicationTemplateVersionsCreated   CommunicationTemplateVersion[] @relation("CommunicationTemplateVersionCreatedBy")
  communicationTemplateVersionsSubmitted CommunicationTemplateVersion[] @relation("CommunicationTemplateVersionSubmittedBy")
  communicationTemplateVersionsDecided   CommunicationTemplateVersion[] @relation("CommunicationTemplateVersionDecidedBy")

  savedReportsCreated SavedReport[] @relation("SavedReportCreatedBy")
  dashboardsCreated   Dashboard[]   @relation("DashboardCreatedBy")

  workflowDefinitionsCreated WorkflowDefinition[]        @relation("WorkflowDefinitionCreatedBy")
  workflowVersionsCreated    WorkflowDefinitionVersion[] @relation("WorkflowVersionCreatedBy")
  workflowTasksAssigned      WorkflowTask[]              @relation("WorkflowTaskAssignedTo")

  jobPostingsPosted JobPosting[] @relation("JobPostingPostedBy")

  passwordResetTokens PasswordResetToken[]

  @@index([isActive])
  @@index([managerId])
}

// Forgot-password flow (§ account management). A raw token is emailed to the
// user and never stored — only its SHA-256 hash is, mirroring the
// timing-safe secret comparison already used for the scheduler's bearer
// token (src/lib/scheduler/auth.ts). `usedAt` makes redemption single-use;
// `expiresAt` is checked the same way offer-expiry.ts checks a stored
// DateTime against `now` (`expiresAt: { gt: now }` for "still valid").
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Role {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  // System roles seeded at install time (see prisma/seed.ts) cannot be deleted,
  // but their permission grants remain fully editable — nothing in the codebase
  // special-cases a role by name.
  isSystem     Boolean  @default(false)
  // Emergency-access escape hatch: bypasses RolePermission/FieldPermission checks
  // entirely. Exactly one seeded "System Administrator" role carries this so a
  // misconfigured permission set can never lock every admin out. Everything else
  // in the system is data-driven — see src/lib/authz/authorize.ts.
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users               UserRole[]
  rolePermissions     RolePermission[]
  fieldPermissions    FieldPermission[]
  approvalStepConfigs ApprovalStepConfig[]

  @@index([isSuperAdmin])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  // Not every resource has an approval concept — src/lib/authz/resource-actions.ts
  // maps each resource to the subset of actions that apply to it, so the role
  // permission matrix doesn't offer an "Approve Users" checkbox.
  APPROVE
}

enum PermissionScope {
  OWN
  TEAM
  ALL
}

// Entity-level grant: "Role X can UPDATE JOB records it OWNs".
model RolePermission {
  id        String           @id @default(cuid())
  roleId    String
  resource  String
  action    PermissionAction
  scope     PermissionScope
  createdAt DateTime         @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@index([resource])
}

enum FieldAccess {
  HIDDEN
  READ
  WRITE
}

// Field-level override on top of RolePermission, e.g. hide Candidate.compensation
// from the Interviewer role even though Interviewer can READ Candidate.
model FieldPermission {
  id        String      @id @default(cuid())
  roleId    String
  resource  String
  field     String
  access    FieldAccess
  createdAt DateTime    @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, field])
  @@index([resource, field])
}

// ---------------------------------------------------------------------------
// Organization & admin settings (§11.13, §13)
// ---------------------------------------------------------------------------

// Deliberately unenforced as a DB-level singleton (no natural single-row constraint
// in Postgres without a trigger); the service layer only ever reads/writes the first
// row. A second row is a data-integrity bug, not a case the schema needs to prevent.
model Organization {
  id                           String   @id @default(cuid())
  name                         String
  timezone                     String   @default("UTC")
  workingDays                  Int[]    @default([1, 2, 3, 4, 5])
  workingHourStart             String   @default("09:00")
  workingHourEnd               String   @default("18:00")
  // Module 12 (§11.5): "automatic email reminders... at configurable
  // intervals" — minutes before Interview.scheduledAt, e.g. [1440, 60] for a
  // 24h and a 1h reminder. One org-wide list rather than a per-interview
  // override or a dedicated settings table — the PRD names no per-job/
  // per-interview variant, and Organization is already this app's one
  // existing global-settings singleton (workingDays/workingHours/timezone).
  // Empty means no automatic reminders are sent.
  interviewReminderLeadMinutes Int[]    @default([1440, 60])
  // §11.6: "Step-level SLA/turnaround-time tracking, configurable per
  // organization" — the org-level default threshold (business days) for
  // getOfferTatComplianceReport's compliance calculation. A caller-supplied
  // `tatThresholdDays` report parameter still overrides this per request
  // (unchanged); this only replaces the previous hardcoded default of 3,
  // so a deployment that never touches this setting sees identical report
  // output to before.
  offerTatThresholdDays        Int      @default(3)
  // §13: "retention limits." Days from Candidate.createdAt after which
  // runDueRetentionSweeps automatically anonymizes a candidate who has no
  // ACTIVE (non-terminal) application — null (the default) means no
  // automatic sweep runs at all, matching this codebase's own "opt-in,
  // never silently on" convention for every other org-level default
  // (offerTatThresholdDays is the one exception, since 3 business days was
  // already this app's pre-existing hardcoded default before it became
  // configurable — there is no equivalent prior behavior to preserve here).
  candidateRetentionDays       Int?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  holidays Holiday[]
}

model Holiday {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  date            DateTime
  recurringYearly Boolean  @default(false)
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
}

// Admin-managed controlled vocabularies (§11.13): rejection reasons, sources,
// document types, locations. New list *types* are created by admins, not by
// deploying code — ControlledList.key is free-form, seeded with the ones the
// PRD names explicitly.
model ControlledList {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values ControlledListValue[]
}

model ControlledListValue {
  id        String   @id @default(cuid())
  listId    String
  value     String
  label     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list ControlledList @relation(fields: [listId], references: [id], onDelete: Cascade)

  jobsAsDepartment Job[]             @relation("JobDepartment")
  jobsAsLocation   Job[]             @relation("JobLocation")
  jobStatusChanges JobStatusChange[]

  candidatesAsSource       Candidate[]         @relation("CandidateSource")
  candidateDocumentsAsType CandidateDocument[] @relation("CandidateDocumentType")
  jobPostingsAsSource      JobPosting[]        @relation("JobPostingSource")

  applicationsAsOutcomeReason Application[]      @relation("ApplicationOutcomeReason")
  applicationEventsAsReason   ApplicationEvent[] @relation("ApplicationEventReason")

  interviewsAsCancellationReason Interview[] @relation("InterviewCancellationReason")

  offersAsOutcomeReason Offer[] @relation("OfferOutcomeReason")

  @@unique([listId, value])
}

// ---------------------------------------------------------------------------
// Customization engine (§10.1) — custom fields & custom objects
// ---------------------------------------------------------------------------

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  DROPDOWN
  MULTI_SELECT
  LOOKUP
}

// Metadata describing one admin-defined field on a core entity (Job, Candidate,
// Application, Offer, ...) or on a Custom Object. The *value* lives in that
// entity's `customFields Json` column — this table only describes shape and
// validation. `entityType` is validated at the service layer against
// src/lib/entity-registry.ts, not a DB foreign key, because core entities are
// not rows in a table.
model CustomFieldDefinition {
  id           String          @id @default(cuid())
  entityType   String
  key          String
  label        String
  fieldType    CustomFieldType
  isRequired   Boolean         @default(false)
  isActive     Boolean         @default(true)
  sortOrder    Int             @default(0)
  // DROPDOWN/MULTI_SELECT choices, LOOKUP target entityType, min/max/regex, etc.
  options      Json?
  defaultValue Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([entityType, key])
  @@index([entityType])
}

// Admin-defined entity (e.g. "Vendor", "Assessment Result") with no dedicated
// table. Deliberately NOT implemented as runtime DDL (no CREATE TABLE at
// request time) — an admin-triggered schema mutation is an operational and
// injection risk out of proportion to the benefit. Records are stored as JSON
// against a shared table instead; CustomFieldDefinition rows with
// entityType = CustomObjectDefinition.apiKey describe each object's fields.
model CustomObjectDefinition {
  id          String   @id @default(cuid())
  apiKey      String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  records CustomObjectRecord[]
}

model CustomObjectRecord {
  id           String   @id @default(cuid())
  definitionId String
  data         Json
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  definition CustomObjectDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  createdBy  User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  relations  CustomObjectRelation[]

  @@index([definitionId])
}

// Links a custom object record to a core entity (e.g. this "Assessment Result"
// record relates to Application #123). relatedEntityType is validated the same
// way as CustomFieldDefinition.entityType.
model CustomObjectRelation {
  id                String   @id @default(cuid())
  recordId          String
  relatedEntityType String
  relatedEntityId   String
  createdAt         DateTime @default(now())

  record CustomObjectRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([relatedEntityType, relatedEntityId])
  @@index([recordId])
}

// ---------------------------------------------------------------------------
// Audit log (§11.13, §13) — every configuration change and lifecycle action
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  // Namespaced action string, e.g. "role.created", "custom_field.updated".
  // Each module appends its own actions; see src/lib/audit/actions.ts.
  action     String
  entityType String
  entityId   String
  // { before, after } snapshot of changed fields only.
  changes    Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Module 2 — Requisition / Job Management (§11.1)
// ---------------------------------------------------------------------------

enum JobStatus {
  DRAFT
  PENDING_APPROVAL
  OPEN
  ON_HOLD
  CLOSED
  CANCELLED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum JobPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Job {
  id String @id @default(cuid())

  title                String
  departmentId         String
  locationId           String
  employmentType       EmploymentType
  priority             JobPriority
  status               JobStatus      @default(DRAFT)
  positionsCount       Int
  // Written only by the future Offer module (hire confirmed). No API route in
  // this module accepts a value for it — see src/lib/validations/job.ts.
  positionsFilledCount Int            @default(0)
  targetDate           DateTime?
  description          String?
  mustHaveCriteria     String[]       @default([])
  goodToHaveCriteria   String[]       @default([])

  customFields Json?

  // "One need splits into multiple roles" (§11.1) — intentionally unconstrained.
  parentJobId String?
  parentJob   Job?    @relation("JobParent", fields: [parentJobId], references: [id], onDelete: SetNull)
  childJobs   Job[]   @relation("JobParent")

  // Denormalized onto Job (in addition to the full list in
  // JobRecruiterAssignment) so every permission check and list-scope filter
  // is a plain column comparison instead of a join. Kept in sync with the
  // JobRecruiterAssignment.isPrimary row inside the same transaction —
  // see updateJobRecruiters in src/lib/services/jobs.ts. This is also the
  // sole ownership anchor for OWN/TEAM scope — the PRD's Job data model
  // (§9) names only "assigned recruiter(s)", so approval ownership resolves
  // against this same column rather than a separate hiring-manager field.
  primaryRecruiterId String
  primaryRecruiter   User   @relation("JobPrimaryRecruiter", fields: [primaryRecruiterId], references: [id])

  createdById String
  createdBy   User   @relation("JobCreatedBy", fields: [createdById], references: [id])

  // Optimistic locking: every update/transition must supply the version it
  // read. See ConflictError in src/lib/errors.ts.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department    ControlledListValue      @relation("JobDepartment", fields: [departmentId], references: [id])
  location      ControlledListValue      @relation("JobLocation", fields: [locationId], references: [id])
  recruiters    JobRecruiterAssignment[]
  statusChanges JobStatusChange[]
  approvals     JobApproval[]

  pipelineStages      PipelineStage[]
  applications        Application[]
  workflowDefinitions WorkflowDefinition[]
  postings            JobPosting[]

  @@index([status])
  @@index([departmentId])
  @@index([locationId])
  @@index([parentJobId])
  @@index([primaryRecruiterId])
}

model JobRecruiterAssignment {
  jobId      String
  userId     String
  isPrimary  Boolean  @default(false)
  assignedAt DateTime @default(now())

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([jobId, userId])
}

// A partial unique index enforcing "at most one primary recruiter per job" at
// the database level is added by hand in the generated migration (Prisma has
// no schema syntax for partial indexes as of this version):
//   CREATE UNIQUE INDEX "job_recruiter_one_primary"
//     ON "JobRecruiterAssignment" ("jobId") WHERE "isPrimary" = true;
// The service layer is still the primary enforcement (it validates exactly
// one isPrimary before writing); this index is the belt-and-suspenders
// backstop against a future bug or a raw SQL write bypassing the service.

model JobStatusChange {
  id         String    @id @default(cuid())
  jobId      String
  fromStatus JobStatus
  toStatus   JobStatus
  // Required by the service for HOLD/CLOSE/CANCEL, null for SUBMIT/APPROVE/
  // REJECT/RESUME. Points at a ControlledListValue in the
  // JOB_HOLD_REASON/JOB_CLOSE_REASON/JOB_CANCEL_REASON list matching toStatus.
  reasonId   String?
  note       String?
  actorId    String
  createdAt  DateTime  @default(now())

  job    Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reason ControlledListValue? @relation(fields: [reasonId], references: [id])
  actor  User                 @relation(fields: [actorId], references: [id])

  @@index([jobId, createdAt])
}

enum JobApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

// Mirrors OfferApproval exactly (§11.1: "configurable approval workflow" —
// same configurable-chain requirement as Offer's, reusing the same
// ApprovalStepConfig admin config and the same shared decideApprovalStep
// helper in src/lib/services/approvals.ts). Kept as its own model rather
// than a polymorphic ApprovalRecord shared with Offer — the two entities'
// own FK column differs (jobId vs offerId) and Prisma has no clean
// polymorphic-relation syntax; a genuinely shared table would need a
// discriminator plus two nullable FKs, which paraphrases this pair of small
// models rather than simplifying them. A separate JobApprovalStatus enum
// (identical values to OfferApprovalStatus) avoids renaming or overloading
// the existing enum other Offer code already references by name.
model JobApproval {
  id    String @id @default(cuid())
  jobId String

  stepOrder        Int     @default(1)
  stepName         String?
  requiredRoleId   String?
  requiredRoleName String?

  status JobApprovalStatus @default(PENDING)

  approverId String?
  approver   User?     @relation("JobApprovalApprover", fields: [approverId], references: [id])
  comments   String?
  decidedAt  DateTime?

  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([jobId, stepOrder])
}

// ---------------------------------------------------------------------------
// Module 3 — Candidate Database (§11.2)
// ---------------------------------------------------------------------------

// "A person, held once globally" (§9) — phone is the PRD's stated unique key;
// email is only a secondary signal for duplicate detection (see
// checkCandidateDuplicates in src/lib/services/candidates.ts), so it is not
// unique-constrained here.
model Candidate {
  id String @id @default(cuid())

  name                 String
  phone                String    @unique
  email                String?
  location             String?
  currentCompensation  Decimal?  @db.Decimal(12, 2)
  expectedCompensation Decimal?  @db.Decimal(12, 2)
  noticePeriodDays     Int?
  earliestAvailability DateTime?
  // §9 lists "experience" as its own Candidate field, distinct from the
  // detailed work-history entries §11.2 asks to store as "professional...
  // data" (below) — kept as two fields per the Phase 2 design.
  totalExperienceYears Decimal?  @db.Decimal(4, 1)
  skills               String[]  @default([])
  tags                 String[]  @default([])
  // Each entry: { company, title, startDate, endDate?, description? } —
  // shape validated by candidateCreateSchema, not DB-enforced (same pattern
  // as Job's customFields).
  experienceHistory    Json?
  // Each entry: { institution, degree, fieldOfStudy?, startYear?, endYear? }
  educationHistory     Json?
  // GDPR-aligned consent capture (§13, §9) — required at creation; there is
  // no "create without consent" path.
  consentGivenAt       DateTime

  // §10.4: which CommunicationTemplateVersion.language a personalized send
  // should prefer (falls back to the template's default "en" content when
  // null or no matching ACTIVE variant exists) — additive, not read by any
  // automated send path yet except bulkEmailApplications.
  preferredLanguage String?

  customFields Json?

  sourceId String?
  source   ControlledListValue? @relation("CandidateSource", fields: [sourceId], references: [id])

  // Ownership anchor for OWN/TEAM permission scope, per the Phase 1 decision:
  // §9's Candidate has no "assigned recruiter" concept (that only exists once
  // the Application entity exists, in a future module), so scope resolves
  // against whoever created the record instead.
  createdById String
  createdBy   User   @relation("CandidateCreatedBy", fields: [createdById], references: [id])

  // Optimistic locking — purely internal, no user-facing surface, same
  // pattern as Job.version.
  version Int @default(0)

  // §13: "GDPR-aligned consent capture and retention limits." Set once, by
  // erasure-request approval or by the automatic retention sweep
  // (runDueRetentionSweeps) — never unset. A non-null value means every PII
  // field above has already been overwritten (see anonymizeCandidateInternal
  // in src/lib/services/candidates.ts); this column is only a marker for
  // "don't re-populate PII here" and UI display, not itself where the
  // erasure happened.
  anonymizedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents       CandidateDocument[]
  notes           CandidateNote[]
  applications    Application[]
  erasureRequests DataErasureRequest[]

  @@index([email])
  @@index([sourceId])
  @@index([createdById])
}

// §13 ("GDPR-aligned consent capture and retention limits"): a request to
// erase one candidate's PII, either staff-initiated (requestedById set) or
// system-initiated by the automatic retention sweep (requestedById null,
// status created directly as COMPLETED — a policy-driven sweep needs no
// per-candidate human sign-off, unlike a staff-initiated request). ANONYMIZE
// overwrites PII fields in place, keeping the row (and its Application/
// Interview/Offer/Handoff history) intact; HARD_DELETE reuses the exact same
// block-if-applications-exist rule deleteCandidate already enforces — it is
// not a way around that rule, just a second, audited entry point to it.
model DataErasureRequest {
  id     String                   @id @default(cuid())
  method DataErasureMethod
  status DataErasureRequestStatus @default(PENDING)
  reason String?

  // Nullable, onDelete: SetNull rather than Cascade — a HARD_DELETE decision
  // must leave this row's own history (method/status/decidedAt/
  // decisionNotes) standing as the audit record that the erasure happened,
  // even though the candidate it was about no longer exists. A Cascade here
  // would delete the request itself the instant it completes, which is
  // backwards for a compliance audit trail.
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  requestedById String?
  requestedBy   User?    @relation("DataErasureRequestedBy", fields: [requestedById], references: [id])
  requestedAt   DateTime @default(now())

  decidedById   String?
  decidedBy     User?     @relation("DataErasureDecidedBy", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  decisionNotes String?

  @@index([candidateId])
  @@index([status])
}

enum DataErasureMethod {
  ANONYMIZE
  HARD_DELETE
}

enum DataErasureRequestStatus {
  PENDING
  COMPLETED
  REJECTED
}

// Multi-document attachment (§11.2). `storageKey` is an opaque handle into
// whichever StorageProvider is configured (src/lib/storage) — never a raw
// filesystem path exposed to clients, so the backing store can change without
// touching this table.
model CandidateDocument {
  id             String   @id @default(cuid())
  candidateId    String
  documentTypeId String
  fileName       String
  mimeType       String
  fileSize       Int
  storageKey     String
  uploadedById   String
  uploadedAt     DateTime @default(now())

  candidate    Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  documentType ControlledListValue @relation("CandidateDocumentType", fields: [documentTypeId], references: [id])
  uploadedBy   User                @relation("CandidateDocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([candidateId])
}

// Team-visible comment feed for the candidate timeline (§11.2, §9). §9
// describes this category ("Task, Note, Activity") as an immutable audit
// log, so there is deliberately no update/delete on this model or its API —
// see src/lib/services/candidates.ts.
model CandidateNote {
  id          String   @id @default(cuid())
  candidateId String
  body        String
  authorId    String
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  author    User      @relation("CandidateNoteAuthor", fields: [authorId], references: [id])

  @@index([candidateId, createdAt])
}

// ---------------------------------------------------------------------------
// Module 4 — Applications / Candidate Pipeline (§11.4)
// ---------------------------------------------------------------------------

enum ApplicationOutcome {
  ACTIVE
  REJECTED
  WITHDRAWN
}

enum ApplicationEventType {
  STAGE_CHANGE
  REJECTED
  WITHDRAWN
}

// PENDING/SENT/FAILED are all written by Module 8 (Communication Hub) —
// bulkEmailApplications resolves SENT/FAILED synchronously from the
// MailProvider result, so a row only stays PENDING for the instant between
// creation and that same request completing. CANCELLED remains unwritten —
// there is no PRD requirement to cancel a queued send — same "field exists,
// nothing writes it yet" pattern as HandoffDeliveryMethod.API_PUSH.
enum EmailLogStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

// Only EMAIL is ever written today (§11.10: SMS is P2, AI chat is Future) —
// same "enum leaves room, only one value is real" pattern as
// HandoffDeliveryMethod.API_PUSH.
enum CommunicationChannel {
  EMAIL
  SMS
}

// The minimal slice of the Template Designer (§10.4) that §11.10's own
// M-requirement ("template-driven, variable-substituted messaging") needs —
// deliberately not the full designer (multi-language variants, conditional
// blocks, version history + approval workflow, offer-letter/document
// generation), which stays its own future module per docs/project-status.md's
// roadmap. Variable substitution reuses the existing renderTemplate() helper
// (src/lib/templates/render.ts) and its `{{key}}` syntax — no new template
// language.
//
// Admin metadata, not a business record: no optimistic-locking `version`
// (matches CustomFieldDefinition/ControlledListValue, not Job/Offer), and no
// hard delete — "removing" a template deactivates it instead (same
// "deactivate, don't delete" convention as PipelineStage), since
// ApplicationEmailLog.templateId keeps a Restrict-backed historical reference
// to whichever template was used for a given send.
model CommunicationTemplate {
  id      String               @id @default(cuid())
  name    String               @unique
  channel CommunicationChannel @default(EMAIL)
  // {{key}} placeholders — see renderTemplate() for the exact variables
  // bulkEmailApplications makes available (candidate.name, job.title).
  subject String
  body    String

  isActive Boolean @default(true)

  createdById String
  createdBy   User   @relation("CommunicationTemplateCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailLogs ApplicationEmailLog[]
  versions  CommunicationTemplateVersion[]

  @@index([channel, isActive])
}

enum CommunicationTemplateVersionStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  ARCHIVED
}

// §10.4's version-history + approval-workflow layer on top of
// CommunicationTemplate — additive, not a replacement: every existing send
// path (bulkEmailApplications, interview reminders/notifications, the
// workflow SEND_EMAIL action) keeps reading CommunicationTemplate.subject/
// body directly and is completely unaware this model exists. Approving an
// "en" version syncs those columns (see decideCommunicationTemplateVersion
// in src/lib/services/communication-template-versions.ts); every other
// language lives only here, resolved by getPersonalizedTemplateContent for
// callers that opt in (currently just bulkEmailApplications, keyed off
// Candidate.preferredLanguage).
//
// `updateCommunicationTemplate`'s existing direct-edit path is untouched —
// this is a parallel, opt-in path, not a mandatory gate in front of it.
//
// At most one ACTIVE version per (templateId, language) — not
// representable in schema.prisma (no partial-index syntax), so it's
// hand-written in the migration, same pattern as PipelineStage's
// active-name uniqueness.
model CommunicationTemplateVersion {
  id         String                @id @default(cuid())
  templateId String
  template   CommunicationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  versionNumber Int
  language      String @default("en")

  subject String
  body    String

  status CommunicationTemplateVersionStatus @default(DRAFT)

  submittedById String?
  submittedBy   User?     @relation("CommunicationTemplateVersionSubmittedBy", fields: [submittedById], references: [id])
  submittedAt   DateTime?

  decidedById String?
  decidedBy   User?     @relation("CommunicationTemplateVersionDecidedBy", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  comments    String?

  createdById String
  createdBy   User     @relation("CommunicationTemplateVersionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([templateId, language, versionNumber])
  @@index([templateId, language, status])
}

// Configurable per job/pipeline (§10.1–10.2, §11.4) — deliberately not a
// Prisma enum (different jobs run different stage sets) and not a
// ControlledList (ControlledList is global and unordered; a job's pipeline
// needs its own per-job ordering). Never hard-deleted once referenced by an
// Application or ApplicationEvent (default onDelete: Restrict on those FKs)
// — "removing" a stage from a pipeline deactivates it instead, the same
// convention ControlledListValue already uses via isActive.
//
// Uniqueness on (jobId, name) is enforced only among ACTIVE stages — a
// hand-written partial unique index added by hand in the generated
// migration (Prisma has no schema syntax for partial indexes, same
// limitation as JobRecruiterAssignment's one-primary-recruiter index):
//   CREATE UNIQUE INDEX "pipeline_stage_active_name_unique"
//     ON "PipelineStage" ("jobId", "name") WHERE "isActive" = true;
// A full (unconditional) unique constraint here would permanently reserve a
// deactivated stage's name and block ever reusing it for a new active
// stage — the opposite of the "deactivate, don't delete" design intent.
model PipelineStage {
  id        String   @id @default(cuid())
  jobId     String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job          Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applications Application[]
  eventsFrom   ApplicationEvent[] @relation("ApplicationEventFromStage")
  eventsTo     ApplicationEvent[] @relation("ApplicationEventToStage")

  @@index([jobId, sortOrder])
}

// "One candidate against one job, holding the pipeline stage" (§9).
// Deliberately no unique constraint on (candidateId, jobId) — re-applying is
// allowed, only warned about (§11.4) — see findDuplicateApplications in
// src/lib/services/applications.ts. candidateId/jobId carry no onDelete
// override (default Restrict): Candidate deletion is blocked by a
// service-layer check in deleteCandidate before it would ever hit this FK;
// Job has no delete endpoint at all.
model Application {
  id String @id @default(cuid())

  candidateId String
  jobId       String
  stageId     String
  ownerId     String

  // Rejected/Withdrawn are terminal outcomes orthogonal to stage, not two of
  // the admin-configurable stages themselves (Phase 2 decision) — stage
  // stays frozen at whatever it was when the outcome was set, and outcome is
  // never reset back to ACTIVE once written.
  outcome         ApplicationOutcome @default(ACTIVE)
  outcomeReasonId String?
  outcomeAt       DateTime?

  stageEnteredAt DateTime @default(now())
  customFields   Json?

  // §11.3: which JobPosting this application arrived through, if any — null
  // for every application created the normal way (recruiter-entered, or via
  // the Refer-a-candidate flow). Deliberately separate from
  // Candidate.sourceId: that column answers "where did this person first
  // come from" (set once, per §9's "held once globally"); this one answers
  // "did THIS specific application arrive via one of our tracked postings" —
  // relevant the moment a candidate applies to more than one job through the
  // same board over time. onDelete: SetNull is a backstop only — JobPosting
  // rows are never deleted (status is toggled POSTED/REMOVED in place), so it
  // never actually fires in normal use, same convention as
  // ApplicationEvent.fromStageId.
  sourcedFromPostingId String?
  sourcedFromPosting   JobPosting? @relation(fields: [sourcedFromPostingId], references: [id], onDelete: SetNull)

  createdById String
  // Optimistic locking — same pattern as Job.version / Candidate.version.
  version     Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidate     Candidate            @relation(fields: [candidateId], references: [id])
  job           Job                  @relation(fields: [jobId], references: [id])
  stage         PipelineStage        @relation(fields: [stageId], references: [id])
  owner         User                 @relation("ApplicationOwner", fields: [ownerId], references: [id])
  createdBy     User                 @relation("ApplicationCreatedBy", fields: [createdById], references: [id])
  outcomeReason ControlledListValue? @relation("ApplicationOutcomeReason", fields: [outcomeReasonId], references: [id])

  events             ApplicationEvent[]
  emailLogs          ApplicationEmailLog[]
  interviews         Interview[]
  offers             Offer[]
  handoffRecords     HandoffRecord[]
  workflowTasks      WorkflowTask[]
  workflowExecutions WorkflowExecution[]

  @@index([candidateId])
  @@index([jobId])
  @@index([jobId, stageId])
  @@index([candidateId, jobId])
  @@index([ownerId])
  @@index([outcome])
  @@index([sourcedFromPostingId])
}

// Immutable history row for every stage move and outcome change — modeled
// directly on JobStatusChange. STAGE_CHANGE events set both fromStageId and
// toStageId; REJECTED/WITHDRAWN events set only fromStageId (a snapshot of
// where the application was when it left the pipeline) plus a required
// reasonId.
model ApplicationEvent {
  id            String               @id @default(cuid())
  applicationId String
  type          ApplicationEventType
  fromStageId   String?
  toStageId     String?
  reasonId      String?
  note          String?
  actorId       String
  createdAt     DateTime             @default(now())

  application Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStage   PipelineStage?       @relation("ApplicationEventFromStage", fields: [fromStageId], references: [id])
  toStage     PipelineStage?       @relation("ApplicationEventToStage", fields: [toStageId], references: [id])
  reason      ControlledListValue? @relation("ApplicationEventReason", fields: [reasonId], references: [id])
  actor       User                 @relation(fields: [actorId], references: [id])

  @@index([applicationId, createdAt])
}

// Originally "infrastructure only" (§11.4, Phase 2 decision) — every row
// wrote status = PENDING and nothing ever sent anything. Module 8
// (Communication Hub, §11.10) completed the wire: bulkEmailApplications
// resolves a CommunicationTemplate, renders it, calls MailProvider, and
// writes the row already as SENT/FAILED. subject/body remain the *rendered*
// text (a snapshot, same "capture once, store the result" choice as
// HandoffRecord.payload), not a live reference to the template — templateId
// records provenance (which template produced this send) without making the
// log dependent on the template's current content.
model ApplicationEmailLog {
  id            String         @id @default(cuid())
  applicationId String
  templateId    String
  toEmail       String
  subject       String
  body          String
  status        EmailLogStatus @default(PENDING)
  requestedById String
  requestedAt   DateTime       @default(now())
  sentAt        DateTime?

  application Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  template    CommunicationTemplate @relation(fields: [templateId], references: [id])
  requestedBy User                  @relation(fields: [requestedById], references: [id])

  @@index([applicationId])
  @@index([status])
  @@index([templateId])
}

// ---------------------------------------------------------------------------
// Module 11 — Sourcing & Job Board Distribution (§11.3)
// ---------------------------------------------------------------------------

enum JobPostingStatus {
  POSTED
  REMOVED
  FAILED
}

/**
 * "Post a job to major job boards from a single requisition" (§11.3) — one
 * persistent row per (job, board), not an append-only log: posting and
 * removing toggle the same row's `status` in place, so `@@unique([jobId,
 * sourceId])` is the real guard against ever posting the same job to the
 * same board twice (the same "let the database's unique constraint be the
 * guard, not a check-then-act pre-check" pattern createOffer/
 * createCommunicationTemplate already use). Never hard-deleted — removing a
 * posting sets status = REMOVED, exactly like every other "deactivate,
 * don't delete" entity in this codebase (PipelineStage, CommunicationTemplate),
 * since Application.sourcedFromPostingId may still reference this row.
 * `sourceId` reuses the *exact same* CANDIDATE_SOURCE controlled list
 * Candidate.sourceId already uses — a posting's board IS the source every
 * inbound application through it gets tagged with, so there is no separate
 * "job board" list to keep in sync with it. RBAC is not its own resource:
 * managing a job's postings is authorized as JOB:<action> scoped to the
 * job's own primaryRecruiterId, the same reuse PipelineStage's configuration
 * already establishes — posting/removing a board listing is a facet of
 * managing the job, not an independent capability.
 */
model JobPosting {
  id String @id @default(cuid())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  sourceId String
  source   ControlledListValue @relation("JobPostingSource", fields: [sourceId], references: [id])

  status JobPostingStatus @default(POSTED)

  // Opaque handle from the (mock, for now) provider — a real board API would
  // return a listing id here, used to target a later removal call.
  externalPostingId String?
  errorMessage      String?

  postedById String
  postedBy   User   @relation("JobPostingPostedBy", fields: [postedById], references: [id])

  postedAt  DateTime  @default(now())
  removedAt DateTime?

  applications Application[]

  @@unique([jobId, sourceId])
  @@index([jobId])
  @@index([sourceId])
}

// ---------------------------------------------------------------------------
// Module 5 — Interview Management (§11.5)
// ---------------------------------------------------------------------------

enum InterviewMode {
  ONSITE
  VIRTUAL
  PHONE
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  // §11.5: "scheduled, completed, cancelled, no-show, tracked as its own
  // metric" — terminal, same as COMPLETED/CANCELLED (assertScheduled blocks
  // any further action once status leaves SCHEDULED). Never auto-assigned:
  // an interviewer/recruiter marks it explicitly via markInterviewNoShow,
  // mirroring cancelInterview/completeInterview's own dedicated-action shape
  // rather than folding it into a generic status PATCH.
  NO_SHOW
}

enum InterviewRecommendation {
  STRONG_YES
  YES
  NO
  STRONG_NO
}

// One scheduled session against one Application — not against Candidate or
// Job directly, since "which pipeline this interview belongs to" is exactly
// what Application already tracks (§9). Interview intentionally has no
// "outcome" of its own: the actual accept/reject/advance decision continues
// to be made through Application's existing transition endpoint (Module 4)
// using the collected feedback as decision support — this module only
// schedules sessions and records structured feedback, never the pipeline
// decision itself.
model Interview {
  id String @id @default(cuid())

  applicationId String

  // Free text, not a Controlled List or a PipelineStage-style config model —
  // "Technical Round 1", "HR Round", etc. vary too freely per job/team to be
  // worth a fixed vocabulary or a second admin-configurable list model this
  // early (cf. mustHaveCriteria's same free-text-list treatment on Job).
  roundName String

  mode     InterviewMode
  // Address for ONSITE, a meeting link for VIRTUAL, a phone number for
  // PHONE — one flexible free-text field rather than three mode-specific
  // columns, since exactly one is ever meaningful per interview.
  location String?

  scheduledAt     DateTime
  durationMinutes Int      @default(60)

  status               InterviewStatus      @default(SCHEDULED)
  cancellationReasonId String?
  cancellationReason   ControlledListValue? @relation("InterviewCancellationReason", fields: [cancellationReasonId], references: [id])

  notes String?

  customFields Json?

  // Ownership anchor for OWN/TEAM scope on the scheduling side (who booked
  // this interview) — mirrors Job.primaryRecruiterId / Application.ownerId.
  // A second, independent access path exists for the assigned interviewers
  // themselves (panelists) — see assertManageAccess / assertReadOrFeedbackAccess
  // in src/lib/services/interviews.ts.
  scheduledById String
  scheduledBy   User   @relation("InterviewScheduledBy", fields: [scheduledById], references: [id])

  // Optimistic locking — same pattern as Job.version / Application.version.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application         @relation(fields: [applicationId], references: [id])
  panelists   InterviewPanelist[]
  feedback    InterviewFeedback[]
  reminders   InterviewReminder[]

  @@index([applicationId])
  @@index([scheduledById])
  @@index([status])
  @@index([scheduledAt])
}

// Which users are assigned to conduct an interview — modeled directly on
// JobRecruiterAssignment, minus isPrimary (the PRD names no "lead
// interviewer" concept, unlike Job's primary recruiter).
model InterviewPanelist {
  interviewId String
  userId      String
  assignedAt  DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([interviewId, userId])
  @@index([userId])
}

// One interviewer's structured feedback for one interview (§8: "Interviewer
// ... submits structured feedback"). Unique per (interview, interviewer) —
// an interviewer files one scorecard per interview, editable up until
// someone reads it as final; there is no separate "submitted" lock, matching
// how Application/Job/Candidate records stay mutable via version rather than
// becoming read-only after creation.
model InterviewFeedback {
  id            String @id @default(cuid())
  interviewId   String
  interviewerId String

  recommendation InterviewRecommendation
  // 1-5, validated at the service layer (not DB-constrained) — same
  // "shape validated by Zod, not DDL" convention as Candidate.totalExperienceYears.
  rating         Int?
  comments       String?

  version     Int      @default(0)
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer User      @relation("InterviewFeedbackInterviewer", fields: [interviewerId], references: [id])

  @@unique([interviewId, interviewerId])
  @@index([interviewId])
}

// ---------------------------------------------------------------------------
// Module 12 — Scheduler Infrastructure (§11.5 reminders / §11.12 scheduled
// reports / §10.2 TIME_IN_STAGE) — see src/lib/scheduler/ for the
// orchestrator and docs/architecture.md for the full design.
// ---------------------------------------------------------------------------

enum InterviewReminderRecipientType {
  CANDIDATE
  PANELIST
}

enum InterviewReminderStatus {
  // A transient "currently being attempted" state, not a resting state —
  // any row found in this status by a later run is either mid-flight (rare)
  // or abandoned by a crashed process (recoverable after a staleness
  // timeout, same "after a timeout" requirement claimExecutionSlot-style
  // idempotency needs to satisfy — see runDueInterviewReminders).
  PROCESSING
  SENT
  // Failed at least once but attempts remain — eligible for another claim
  // once nextAttemptAt passes.
  RETRYING
  // attempts exhausted, or no email existed to send to in the first place.
  FAILED
}

// One row per (interview occurrence, lead time, recipient) reminder the
// scheduler either sent or attempted — "candidate and panel reminders are
// separate" (Phase-1 decision): each panelist and the candidate get their
// own row, mirroring ApplicationEmailLog's existing one-row-per-recipient
// shape (Module 8) rather than inventing a batched "one row per interview"
// concept.
//
// `scheduledAtFingerprint` (Interview.scheduledAt at claim time, as an ISO
// string) is folded into the uniqueness key for exactly the same reason
// WorkflowExecution's fingerprint is: rescheduling an interview changes
// scheduledAt, which naturally makes prior reminder rows for the *old* time
// irrelevant (the "is this due" query now computes dueAt from the new
// scheduledAt) without any explicit invalidation step, while still letting
// a *new* reminder be claimed and sent for the new time — the same
// "leaving and re-entering a stage produces a fresh fingerprint" pattern
// TIME_IN_STAGE already established.
//
// `recipientId` is always non-null (the literal string "candidate", or a
// PANELIST's User.id) specifically so it can sit in a real, DB-enforced
// unique constraint — Postgres unique indexes don't treat two NULLs as
// equal, which would have silently defeated a nullable-panelistId column
// used the same way.
model InterviewReminder {
  id String @id @default(cuid())

  interviewId            String
  interview              Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  scheduledAtFingerprint String
  leadMinutes            Int

  recipientType InterviewReminderRecipientType
  recipientId   String
  // Snapshot at claim time — if a candidate's email changes between claim
  // and a later retry, the retry keeps targeting the address that was valid
  // when this reminder was first due, the same "frozen at creation" choice
  // HandoffRecord's payload snapshot already establishes elsewhere.
  toEmail       String?

  status        InterviewReminderStatus @default(PROCESSING)
  attempts      Int                     @default(0)
  lastError     String?
  nextAttemptAt DateTime?
  sentAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([interviewId, scheduledAtFingerprint, leadMinutes, recipientId])
  @@index([status, nextAttemptAt])
}

enum OfferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  EXTENDED
  ACCEPTED
  DECLINED
  REVOKED
  // §11.6: "in progress, extended, accepted, declined, lapsed, revoked."
  // Automatic-only (see runDueOfferExpirations in
  // src/lib/services/offer-expiry.ts) — reachable only from EXTENDED, once
  // Offer.respondByDate has passed with no candidate decision recorded.
  // There is deliberately no manual "mark lapsed" action: the PRD names
  // this as an automatic-expiry status, not an actor-triggered transition
  // like DECLINE/REVOKE, so it has no entry in OFFER_TRANSITIONS.
  LAPSED
}

enum OfferApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  // A later step's row when an earlier step REJECTs — the whole chain is
  // rejected on the first REJECT (existing single-step semantics preserved),
  // so any step that never got reached is closed out instead of sitting
  // PENDING forever. Also used defensively on any stray PENDING row from a
  // superseded submission cycle when a fresh SUBMIT creates a new set of
  // step rows (see createOfferApprovalSteps).
  SKIPPED
}

// Shared by both Job and Offer's configurable approval chains (§11.1/§11.6)
// — one admin-defined, ordered sequence of steps per entity type, each step
// requiring a specific Role to decide it. Reuses the existing Role model
// directly rather than inventing a new approver-assignment concept, per
// "approval steps must have meaningful approver semantics consistent with
// existing RBAC." Configuring this is itself gated as JOB:UPDATE / OFFER:
// UPDATE at ALL scope (see src/lib/services/approvals.ts) — a new
// PermissionAction/resource was deliberately not introduced for it.
//
// Editing the chain is a full-set replace (delete all rows for that
// entityType, recreate), the same "replace, don't patch" convention
// replacePipelineStages/replaceRolePermissions already use — there is no
// per-step id a client edits in place. This is deliberately NOT itself the
// audit trail: JobApproval/OfferApproval snapshot each step's
// name/requiredRoleId/requiredRoleName at SUBMIT time, so a later edit here
// never rewrites the history of an approval already in progress or decided
// (see "handle configuration changes safely for jobs already in progress").
enum ApprovalEntityType {
  JOB
  OFFER
}

model ApprovalStepConfig {
  id         String             @id @default(cuid())
  entityType ApprovalEntityType

  stepOrder Int
  name      String

  requiredRoleId String
  requiredRole   Role   @relation(fields: [requiredRoleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityType, stepOrder])
  @@index([entityType])
}

// One offer against one Application — same anchoring choice as Interview,
// for the same reason (§9: Application already tracks which pipeline this
// belongs to). An Application can have more than one Offer over its life
// (a declined/revoked offer followed by a revised one); "at most one
// non-terminal Offer per Application at a time" is checked in the service
// layer (createOffer) for a friendly error, backed by a hand-written
// partial unique index (not representable in schema.prisma — no
// partial-index syntax — so it's added directly in the generated
// migration, same pattern as JobRecruiterAssignment's one-primary-recruiter
// index and PipelineStage's active-name index):
//   CREATE UNIQUE INDEX "offer_one_active_per_application"
//     ON "Offer" ("applicationId")
//     WHERE "status" IN ('DRAFT', 'PENDING_APPROVAL', 'APPROVED', 'EXTENDED');
//
// Status is a fixed table-driven state machine (src/lib/offers/status-machine.ts),
// mirroring Job's — Offer's lifecycle (draft → submit → approve/reject →
// extend → accept/decline, plus revoke from anywhere non-terminal) is a
// true sequential workflow like Job's, unlike Interview's independent
// schedule/cancel/complete actions. No separate OfferStatusChange history
// table exists for the same reason Interview has no InterviewEvent table:
// `updatedAt` + `status` is enough for the transitions that are plain status
// flips (extend/accept/decline/revoke); the one transition rich enough to
// need its own record — the approval decision — gets OfferApproval below.
model Offer {
  id String @id @default(cuid())

  applicationId String

  // §9's compensation fields (Candidate.currentCompensation /
  // expectedCompensation) use this exact type — same convention, not a new one.
  compensation        Decimal   @db.Decimal(12, 2)
  expectedJoiningDate DateTime?

  // §11.6: "Offer record with compensation, joining date, designation,
  // location... tied to the application" — first-class fields, not folded
  // into customFields, since the PRD names them as core Offer attributes.
  designation String?
  location    String?

  // Optional response deadline, set (or changed) only on the EXTEND
  // transition — an Offer with no deadline simply never auto-lapses,
  // preserving today's behavior for every offer that doesn't opt in. Once
  // past, runDueOfferExpirations (src/lib/services/offer-expiry.ts) is what
  // actually moves EXTENDED -> LAPSED; see OfferStatus.LAPSED's own comment.
  respondByDate DateTime?

  notes String?

  customFields Json?

  status OfferStatus @default(DRAFT)

  // Shared between DECLINE and REVOKE — same "one outcome + one reason field"
  // choice Application makes for REJECTED/WITHDRAWN, rather than Job's
  // one-list-per-action split, since Decline/Revoke map onto Application's
  // reject/withdraw shape (terminal negative outcome, different actors, one
  // reason vocabulary) more closely than onto Job's per-situation lists.
  outcomeReasonId String?
  outcomeReason   ControlledListValue? @relation("OfferOutcomeReason", fields: [outcomeReasonId], references: [id])

  // Ownership anchor for OWN/TEAM scope — mirrors Job.primaryRecruiterId /
  // Interview.scheduledById. Offer has only this one ownership facet (no
  // panelist-style second actor), so access resolves through a single
  // assertOfferAccess function, the same shape as Job's assertJobAccess,
  // not Interview's two-function split.
  createdById String
  createdBy   User   @relation("OfferCreatedBy", fields: [createdById], references: [id])

  // Optimistic locking — same pattern as Job.version / Interview.version.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application   Application     @relation(fields: [applicationId], references: [id])
  approvals     OfferApproval[]
  handoffRecord HandoffRecord?

  @@index([applicationId])
  @@index([createdById])
  @@index([status])
}

// One row per approval attempt (created PENDING when an Offer is submitted,
// updated in place when decided) — an append-only history of approval
// attempts, not a single mutable "current approval" field, so a
// reject → revise → resubmit cycle keeps every prior attempt's outcome
// instead of overwriting it. `approverId` is null until someone actually
// decides it; any user holding OFFER:APPROVE may act on a PENDING row, so
// this isn't a pre-assigned reviewer, matching how Job's approval step
// doesn't pre-assign an approver either.
model OfferApproval {
  id      String @id @default(cuid())
  offerId String

  // §11.6: "configurable approval steps before an offer is issued." One row
  // per configured ApprovalStepConfig step is created at SUBMIT time
  // (stepOrder/name/requiredRoleId snapshotted then, per the
  // ApprovalStepConfig model's own comment on why this must be a snapshot,
  // not a live reference) — or exactly one legacy row (stepOrder 1, no
  // snapshot) when no chain is configured, preserving the original
  // single-step behavior byte-for-byte. requiredRoleName is denormalized
  // alongside requiredRoleId so display/audit never needs a live join and
  // is immune to a later role rename or deletion.
  stepOrder        Int     @default(1)
  stepName         String?
  requiredRoleId   String?
  requiredRoleName String?

  status OfferApprovalStatus @default(PENDING)

  approverId String?
  approver   User?     @relation("OfferApprovalApprover", fields: [approverId], references: [id])
  comments   String?
  decidedAt  DateTime?

  createdAt DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@index([offerId, stepOrder])
}

enum HandoffStatus {
  PENDING
  DELIVERED
  ACCEPTED
  EXCEPTION
}

// Only STRUCTURED_EXPORT is ever written today — no real HRIS integration
// exists yet (§12), so src/lib/hris/ has exactly one provider, the same
// "field exists, only a later module writes the other value" pattern as
// EmailLogStatus / Job.positionsFilledCount. API_PUSH is here so a future
// real HRIS connector is a new provider implementation and a value this
// column already accepts, not a schema change.
enum HandoffDeliveryMethod {
  API_PUSH
  STRUCTURED_EXPORT
}

// Triggered by Offer's ACCEPT transition (src/lib/services/offers.ts), one
// handoff per accepted Offer — @unique on offerId rather than a modeled
// "at most one active handoff per application" rule like Offer's own,
// because Offer's status machine already guarantees at most one Offer per
// Application ever reaches ACCEPTED (every other terminal/non-terminal
// status is excluded from triggering a handoff at all).
//
// `payload` is a snapshot assembled once at creation (candidate profile +
// final offer terms + the candidate's document list), not a live join —
// same "render/capture once, store the result" choice as
// ApplicationEmailLog.subject/body, so what HR received stays stable even
// if the candidate record changes afterward. See buildHandoffPayload in
// src/lib/services/handoffs.ts.
//
// Lifecycle is a handful of named actions (retryHandoff, acknowledgeHandoff),
// not a table-driven state machine like Job/Offer — Handoff's shape (attempt
// delivery, retry on failure, get acknowledged) is closer to Interview's
// independent actions than to a long sequential workflow, so it doesn't
// warrant that abstraction (Phase 1 decision: don't over-engineer this).
//
// Acknowledgement reuses the existing global APPROVE permission action
// (HR/Onboarding is granted HANDOFF:APPROVE in prisma/seed.ts): confirming
// a handoff was received correctly is the same kind of gatekeeper decision
// Job/Offer's APPROVE already models, so this needed no new
// PermissionAction value.
//
// Once ACCEPTED, the linked Application becomes read-only: assertApplicationNotHandedOff
// (exported from src/lib/services/handoffs.ts) is called from
// transitionApplication, scheduleInterview, and createOffer so a hired-and-
// handed-off candidate's application can't be rejected/withdrawn/re-staged
// and can't collect a new interview or offer — no new field on Application
// itself, this table is the sole source of truth for "is this archived."
model HandoffRecord {
  id String @id @default(cuid())

  offerId       String @unique
  applicationId String

  status         HandoffStatus         @default(PENDING)
  deliveryMethod HandoffDeliveryMethod

  // Assembled once at creation — see the model comment above.
  payload Json

  // Set by a successful push/export attempt or left null for STRUCTURED_EXPORT,
  // which has no external system to hand back an id from.
  externalReferenceId String?
  // Free text, not a Controlled List — a delivery failure or an HR-flagged
  // data issue is too open-ended for a fixed vocabulary, same reasoning as
  // InterviewFeedback.comments / OfferApproval.comments.
  exceptionReason     String?

  customFields Json?

  // Who accepted the Offer that triggered this handoff — the ownership
  // anchor for OWN/TEAM scope, mirroring Offer.createdById.
  initiatedById String
  initiatedBy   User   @relation("HandoffInitiatedBy", fields: [initiatedById], references: [id])

  acknowledgedById String?
  acknowledgedBy   User?     @relation("HandoffAcknowledgedBy", fields: [acknowledgedById], references: [id])
  acknowledgedAt   DateTime?

  // Optimistic locking — same pattern as Offer.version / Interview.version.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offer       Offer                    @relation(fields: [offerId], references: [id])
  application Application              @relation(fields: [applicationId], references: [id])
  attempts    HandoffDeliveryAttempt[]

  @@index([applicationId])
  @@index([status])
  // OWN/TEAM-scope listHandoffs filters on initiatedById — same "index the
  // ownership column list queries scope against" precedent as
  // Offer.@@index([createdById]).
  @@index([initiatedById])
}

// One row per delivery attempt (the initial automatic attempt on ACCEPT,
// plus every manual retry) — an append-only history, same shape as
// OfferApproval: never overwritten, so a flaky first attempt's error
// stays visible even after a later retry succeeds.
model HandoffDeliveryAttempt {
  id              String @id @default(cuid())
  handoffRecordId String

  deliveryMethod      HandoffDeliveryMethod
  succeeded           Boolean
  externalReferenceId String?
  errorMessage        String?

  attemptedById String
  attemptedBy   User     @relation(fields: [attemptedById], references: [id])
  attemptedAt   DateTime @default(now())

  handoffRecord HandoffRecord @relation(fields: [handoffRecordId], references: [id], onDelete: Cascade)

  @@index([handoffRecordId])
}

// ---------------------------------------------------------------------------
// Module 9 — Reporting & Analytics (§11.12)
// ---------------------------------------------------------------------------

// The four pre-built report types (§11.12's M-requirements, minus the
// "custom dashboard and report builder" line — see SavedReport's comment
// below for why that stays a saved *selection* of one of these four rather
// than a generic drag-and-drop widget engine over arbitrary entities and
// custom fields).
enum ReportType {
  PIPELINE_FUNNEL
  TIME_TO_FILL_AND_OFFER
  RECRUITER_PRODUCTIVITY
  OFFER_TAT_COMPLIANCE
}

enum ReportExportFormat {
  XLSX
  CSV
  PDF
}

enum ReportScheduleFrequency {
  NONE
  DAILY
  WEEKLY
}

enum ReportRunStatus {
  SENT
  FAILED
}

// A saved, shareable report definition (§10.5: "saved, shareable report
// definitions with schedule-based email delivery"). Deliberately not a
// generic drag-and-drop dashboard-builder record — `reportType` picks one of
// the four pre-built §11.12 reports and `filters` narrows its inputs; there
// is no widget layout, no arbitrary-entity query, no custom-field
// aggregation here. That full builder is out of scope for this pass, the
// same deliberate cut Module 8 made shrinking the Template Designer down to
// single-channel, no-versioning template rendering.
//
// Business-record tier, not admin-metadata tier: unlike CommunicationTemplate
// (open read for everyone), a saved report can be configured to email
// arbitrary recipient addresses on a schedule, so *defining* one needs a
// real seeded grant (the SAVED_REPORT resource) rather than open access —
// `version` for optimistic locking and OWN/TEAM/ALL scope on createdById,
// same shape as Job/Offer. `name` is intentionally not unique (unlike
// CommunicationTemplate) since these are personal/team artifacts, not a
// shared org-wide vocabulary — two recruiters each naming a report "Weekly
// Funnel" is expected, not a conflict.
//
// Row-level security (§10.5's third bullet) is NOT baked into this record —
// running a saved report re-applies the *runner's own* permission scope on
// the underlying entity (Job/Application/Offer) at run time, via the same
// getEffectiveScope() every list endpoint already uses (see
// src/lib/services/reports.ts). Two users sharing the same SavedReport
// therefore see different rows, which is the actual row-level-security
// requirement — storing a fixed row-set on the definition itself would
// violate it.
model SavedReport {
  id         String     @id @default(cuid())
  name       String
  reportType ReportType

  // Shape depends on reportType — validated by Zod
  // (src/lib/validations/report.ts), not DB-enforced, same "JSON shape
  // validated at the service boundary" convention as Job.customFields.
  filters Json @default("{}")

  scheduleFrequency ReportScheduleFrequency @default(NONE)
  // Only meaningful when scheduleFrequency != NONE.
  recipientEmails   String[]                @default([])
  exportFormat      ReportExportFormat      @default(XLSX)

  lastRunAt     DateTime?
  lastRunStatus ReportRunStatus?

  createdById String
  createdBy   User   @relation("SavedReportCreatedBy", fields: [createdById], references: [id])

  // Optimistic locking — same pattern as Job.version / Offer.version.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  // Matches the "find due scheduled reports" query shape exactly — same
  // "index the actual query pattern" precedent as
  // CommunicationTemplate.@@index([channel, isActive]).
  @@index([scheduleFrequency, lastRunAt])
}

// ---------------------------------------------------------------------------
// §10.5 — Custom Dashboards & Reports (post-launch)
// ---------------------------------------------------------------------------

// A saved, shareable collection of widgets over any entity — including
// custom objects and their own custom fields, not just the four pre-built
// §11.12 reports SavedReport already covers. "Shareable" mirrors
// SavedReport's own shape exactly: no per-record ACL model, an ALL-scope
// DASHBOARD:READ grant simply sees every dashboard, the same way an
// ALL-scope SAVED_REPORT:READ grant already does.
model Dashboard {
  id          String  @id @default(cuid())
  name        String
  description String?

  createdById String
  createdBy   User   @relation("DashboardCreatedBy", fields: [createdById], references: [id])

  // Optimistic locking — same pattern as SavedReport.version.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  widgets DashboardWidget[]

  @@index([createdById])
}

enum DashboardAggregate {
  COUNT
  SUM
  AVG
  MIN
  MAX
}

// One tile: an entity + an aggregate (+ optional group-by and filters).
// Row-level security is never stored here — see the widget-query engine
// (src/lib/reporting/dashboard-query.ts), which always re-fetches through
// the target entity's own scoped list service at render time, the exact
// "recomputed against the current viewer, never a row-set frozen at save
// time" precedent SavedReport's own row-level-security note establishes.
model DashboardWidget {
  id          String    @id @default(cuid())
  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  title      String
  // One of CUSTOM_FIELD_CAPABLE_ENTITIES (src/lib/entity-registry.ts), or a
  // CustomObjectDefinition's own apiKey — validated at the service boundary
  // against the live set of active custom objects, not a DB enum, the same
  // reason CustomFieldDefinition.entityType is a plain string.
  entityType String

  aggregate  DashboardAggregate @default(COUNT)
  // The field to aggregate (ignored for COUNT); "customFields.<key>"
  // addresses a custom field, same dot-path convention FieldPermission.field
  // already uses for the same reason (one flat namespace, no second schema).
  fieldKey   String?
  // The field to group results by; null means a single overall total.
  groupByKey String?

  // AND-only array of { field, operator, value } — deliberately the exact
  // same shape as WorkflowCondition (src/lib/validations/workflow.ts), not
  // a second filter DSL. Validated by Zod at the service boundary, same
  // "JSON shape validated at the service boundary" convention as
  // Job.customFields.
  filters Json @default("[]")

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dashboardId])
}

// ---------------------------------------------------------------------------
// Module 10 — Workflow & Automation Builder (§10.2)
// ---------------------------------------------------------------------------

// "Form submission" maps to Application creation — the closest existing
// "intake" event in this codebase; there is no separate public-facing form
// entity. TIME_IN_STAGE is evaluated by runDueTimeInStageWorkflows (see
// src/lib/services/workflows.ts), not event-driven like the other three —
// same "no cron/queue infrastructure exists in this app" limitation Module
// 9's scheduled reports already document.
enum WorkflowTriggerType {
  STAGE_CHANGE
  FIELD_UPDATE
  TIME_IN_STAGE
  FORM_SUBMISSION
}

// "Change a field" is scoped to Application.customFields only (see
// WorkflowDefinitionVersion's own comment) — there is no CHANGE_STAGE action;
// the PRD's action list names none, and Application's core lifecycle fields
// (stageId/outcome/ownerId) already have their own state-machine-guarded
// paths (transitionApplication/updateApplication) that a generic field
// setter would bypass. "Send templated email/notification" is EMAIL only —
// the one real channel this codebase has (Module 8); there is no separate
// in-app notification system. CREATE_TASK and REQUEST_APPROVAL both produce
// a WorkflowTask row — request-approval is a task with an approve/reject
// outcome instead of a plain done/not-done one.
enum WorkflowActionType {
  SEND_EMAIL
  CREATE_TASK
  CHANGE_FIELD
  REASSIGN_OWNER
  REQUEST_APPROVAL
}

enum WorkflowTaskStatus {
  OPEN
  DONE
  APPROVED
  REJECTED
}

// One automation rule. Deliberately not itself the mutable config — every
// edit to trigger/conditions/actions creates a new WorkflowDefinitionVersion
// row and re-points activeVersionId, so "full version history... with the
// ability to roll back" (§10.2's own last bullet) falls out of an
// append-only child table rather than a separate history mechanism, the
// same "append-only, never overwritten" convention as JobStatusChange/
// ApplicationEvent/OfferApproval.
//
// `jobId` null means "applies to every job's pipeline" — §10.2: "Per-job and
// per-pipeline configuration, so a configuration used for one hiring
// process does not have to apply globally." onDelete: Cascade — a workflow
// scoped to one job has no meaning once that job is gone (Job currently has
// no delete endpoint, so this is a forward-looking safety net, not a live
// path).
//
// Business-record tier, not admin-metadata tier: has OWN/TEAM/ALL scope and
// optimistic-locking `version`, the same choice Module 9 made for
// SavedReport over CommunicationTemplate's open-read tier — an automation
// can send email, reassign ownership, and create approval-gated tasks
// without further per-action human review, a real side-effect risk serious
// enough to need a real seeded grant. No hard delete — WorkflowTask rows
// hold a historical reference to whichever version created them (Restrict),
// so "removing" a workflow deactivates it instead, same convention as
// PipelineStage/CommunicationTemplate.
model WorkflowDefinition {
  id   String @id @default(cuid())
  name String

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  activeVersionId String?                     @unique
  activeVersion   WorkflowDefinitionVersion?  @relation("WorkflowDefinitionActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  versions        WorkflowDefinitionVersion[] @relation("WorkflowDefinitionVersions")

  createdById String
  createdBy   User   @relation("WorkflowDefinitionCreatedBy", fields: [createdById], references: [id])

  // Optimistic locking — same pattern as Job.version/Offer.version. Guards
  // both plain metadata edits (name/isActive) and the version-bump-plus-
  // repoint-activeVersionId transaction that a config change performs.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId, isActive])
  @@index([createdById])
}

// One saved configuration snapshot — created once, never updated in place.
// `triggerConfig`/`conditions`/`actions` are JSON (shape depends on
// triggerType/each action's own type), validated by Zod at the service
// boundary (src/lib/validations/workflow.ts), not DB-enforced — same "JSON
// shape validated at the service boundary" convention as Job.customFields.
// `conditions` is an array evaluated as AND-only, matching §10.2's own
// literal phrasing: "when [event] and [condition], then [action]" — there
// is no OR/grouping support.
model WorkflowDefinitionVersion {
  id                   String @id @default(cuid())
  workflowDefinitionId String

  versionNumber Int

  triggerType   WorkflowTriggerType
  triggerConfig Json                @default("{}")
  conditions    Json                @default("[]")
  actions       Json

  createdById String
  createdBy   User   @relation("WorkflowVersionCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  workflowDefinition WorkflowDefinition  @relation("WorkflowDefinitionVersions", fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  activeFor          WorkflowDefinition? @relation("WorkflowDefinitionActiveVersion")
  tasksCreated       WorkflowTask[]
  executions         WorkflowExecution[]

  @@unique([workflowDefinitionId, versionNumber])
  @@index([workflowDefinitionId])
}

// Backs both CREATE_TASK (plain OPEN -> DONE) and REQUEST_APPROVAL (OPEN ->
// APPROVED/REJECTED instead) — one model, not two, since both are
// fundamentally "something a person needs to act on regarding an
// Application," differing only in what "acted on" means. `sourceVersionId`
// is optional, defaulting to Prisma's SetNull-on-delete for an optional
// relation — never actually exercised, since neither WorkflowDefinition nor
// WorkflowDefinitionVersion rows are ever deleted (deactivate-only, same as
// PipelineStage/CommunicationTemplate); a task's provenance link is
// permanent for the life of the system in practice.
model WorkflowTask {
  id String @id @default(cuid())

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  title       String
  description String?

  // Ownership anchor for task-completion access — resolved independently of
  // Application.ownerId (see assertWorkflowTaskAccess in
  // src/lib/services/workflows.ts), the same "two independent access paths"
  // shape Interview already uses for scheduler-vs-panelist.
  assignedToId String
  assignedTo   User   @relation("WorkflowTaskAssignedTo", fields: [assignedToId], references: [id])

  status WorkflowTaskStatus @default(OPEN)
  dueAt  DateTime?

  sourceVersionId String?
  sourceVersion   WorkflowDefinitionVersion? @relation(fields: [sourceVersionId], references: [id])

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([applicationId])
  @@index([assignedToId, status])
}

enum WorkflowExecutionStatus {
  SUCCESS
  PARTIAL_FAILURE
  FAILED
}

// One row per time a workflow actually ran against one application — gives
// an admin real visibility into "did my automation fire and what happened,"
// and (for TIME_IN_STAGE specifically) is the idempotency guard against
// firing twice for the same stay in a stage. `fingerprint` is a
// trigger-type-specific string identifying *this occurrence* of the
// trigger — the ApplicationEvent id for STAGE_CHANGE, the Application's own
// id for FORM_SUBMISSION (an application is only ever created once), an
// `updatedAt` ISO string for FIELD_UPDATE, and `stageEnteredAt`'s ISO string
// for TIME_IN_STAGE (so leaving and re-entering the same stage later gets a
// new fingerprint and can fire again) — see src/lib/services/workflows.ts.
// The unique constraint is the real guard against runDueTimeInStageWorkflows
// firing the same stay twice across repeated calls; for the three
// event-driven triggers it's cheap insurance, never actually exercised,
// since each is only ever called once per real write.
model WorkflowExecution {
  id String @id @default(cuid())

  workflowDefinitionVersionId String
  workflowDefinitionVersion   WorkflowDefinitionVersion @relation(fields: [workflowDefinitionVersionId], references: [id], onDelete: Cascade)

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  fingerprint String

  status         WorkflowExecutionStatus
  actionsSummary Json
  errorMessage   String?

  executedAt DateTime @default(now())

  @@unique([workflowDefinitionVersionId, applicationId, fingerprint])
  @@index([applicationId])
}
