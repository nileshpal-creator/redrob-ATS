// Module 1 — Foundation: Auth, RBAC, Custom Field Engine, Admin Settings
//
// Design notes (see /docs/architecture/module-1-foundation.md for the full writeup):
// - `resource`/`entityType` fields below are deliberately plain strings, not Prisma enums.
//   Every later module (Job, Candidate, Application, ...) plugs into RBAC, custom fields,
//   and the audit log by registering a key in `src/lib/entity-registry.ts` — no migration
//   needed to grant a new module access to these cross-cutting engines.
// - `AuditLog.action` is a namespaced string ("candidate.created") for the same reason:
//   the set of actions grows every module; a closed enum would need a migration per module.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & RBAC
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  avatarUrl    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // One-level reporting line, not a full Team entity — the PRD's "Recruiting
  // Manager oversees a team's requisitions" (§8) is the only team concept
  // v1 needs. This is what PermissionScope.TEAM resolves against in
  // src/lib/authz/authorize.ts: a manager's TEAM grant covers their direct
  // reports' records. Revisit if a later module needs multi-level teams.
  managerId String?
  manager   User?   @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)

  directReports User[]               @relation("UserManager")
  roles         UserRole[]
  auditLogs     AuditLog[]
  customRecords CustomObjectRecord[]

  jobsCreated             Job[]                    @relation("JobCreatedBy")
  jobsAsPrimaryRecruiter  Job[]                    @relation("JobPrimaryRecruiter")
  jobRecruiterAssignments JobRecruiterAssignment[]
  jobStatusChangesActed   JobStatusChange[]

  candidatesCreated          Candidate[]         @relation("CandidateCreatedBy")
  candidateDocumentsUploaded CandidateDocument[] @relation("CandidateDocumentUploadedBy")
  candidateNotesAuthored     CandidateNote[]     @relation("CandidateNoteAuthor")

  applicationsOwned          Application[]         @relation("ApplicationOwner")
  applicationsCreated        Application[]         @relation("ApplicationCreatedBy")
  applicationEventsActed     ApplicationEvent[]
  applicationEmailsRequested ApplicationEmailLog[]

  interviewsScheduled       Interview[]         @relation("InterviewScheduledBy")
  interviewPanelAssignments InterviewPanelist[]
  interviewFeedbackAuthored InterviewFeedback[] @relation("InterviewFeedbackInterviewer")

  offersCreated    Offer[]         @relation("OfferCreatedBy")
  offerApprovalsAs OfferApproval[] @relation("OfferApprovalApprover")

  handoffsInitiated    HandoffRecord[]          @relation("HandoffInitiatedBy")
  handoffsAcknowledged HandoffRecord[]          @relation("HandoffAcknowledgedBy")
  handoffAttemptsActed HandoffDeliveryAttempt[]

  @@index([isActive])
  @@index([managerId])
}

model Role {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  // System roles seeded at install time (see prisma/seed.ts) cannot be deleted,
  // but their permission grants remain fully editable — nothing in the codebase
  // special-cases a role by name.
  isSystem     Boolean  @default(false)
  // Emergency-access escape hatch: bypasses RolePermission/FieldPermission checks
  // entirely. Exactly one seeded "System Administrator" role carries this so a
  // misconfigured permission set can never lock every admin out. Everything else
  // in the system is data-driven — see src/lib/authz/authorize.ts.
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users            UserRole[]
  rolePermissions  RolePermission[]
  fieldPermissions FieldPermission[]

  @@index([isSuperAdmin])
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  // Not every resource has an approval concept — src/lib/authz/resource-actions.ts
  // maps each resource to the subset of actions that apply to it, so the role
  // permission matrix doesn't offer an "Approve Users" checkbox.
  APPROVE
}

enum PermissionScope {
  OWN
  TEAM
  ALL
}

// Entity-level grant: "Role X can UPDATE JOB records it OWNs".
model RolePermission {
  id        String           @id @default(cuid())
  roleId    String
  resource  String
  action    PermissionAction
  scope     PermissionScope
  createdAt DateTime         @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@index([resource])
}

enum FieldAccess {
  HIDDEN
  READ
  WRITE
}

// Field-level override on top of RolePermission, e.g. hide Candidate.compensation
// from the Interviewer role even though Interviewer can READ Candidate.
model FieldPermission {
  id        String      @id @default(cuid())
  roleId    String
  resource  String
  field     String
  access    FieldAccess
  createdAt DateTime    @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, field])
  @@index([resource, field])
}

// ---------------------------------------------------------------------------
// Organization & admin settings (§11.13, §13)
// ---------------------------------------------------------------------------

// Deliberately unenforced as a DB-level singleton (no natural single-row constraint
// in Postgres without a trigger); the service layer only ever reads/writes the first
// row. A second row is a data-integrity bug, not a case the schema needs to prevent.
model Organization {
  id               String   @id @default(cuid())
  name             String
  timezone         String   @default("UTC")
  workingDays      Int[]    @default([1, 2, 3, 4, 5])
  workingHourStart String   @default("09:00")
  workingHourEnd   String   @default("18:00")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  holidays Holiday[]
}

model Holiday {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  date            DateTime
  recurringYearly Boolean  @default(false)
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
}

// Admin-managed controlled vocabularies (§11.13): rejection reasons, sources,
// document types, locations. New list *types* are created by admins, not by
// deploying code — ControlledList.key is free-form, seeded with the ones the
// PRD names explicitly.
model ControlledList {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values ControlledListValue[]
}

model ControlledListValue {
  id        String   @id @default(cuid())
  listId    String
  value     String
  label     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  list ControlledList @relation(fields: [listId], references: [id], onDelete: Cascade)

  jobsAsDepartment Job[]             @relation("JobDepartment")
  jobsAsLocation   Job[]             @relation("JobLocation")
  jobStatusChanges JobStatusChange[]

  candidatesAsSource       Candidate[]         @relation("CandidateSource")
  candidateDocumentsAsType CandidateDocument[] @relation("CandidateDocumentType")

  applicationsAsOutcomeReason Application[]      @relation("ApplicationOutcomeReason")
  applicationEventsAsReason   ApplicationEvent[] @relation("ApplicationEventReason")

  interviewsAsCancellationReason Interview[] @relation("InterviewCancellationReason")

  offersAsOutcomeReason Offer[] @relation("OfferOutcomeReason")

  @@unique([listId, value])
}

// ---------------------------------------------------------------------------
// Customization engine (§10.1) — custom fields & custom objects
// ---------------------------------------------------------------------------

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  DROPDOWN
  MULTI_SELECT
  LOOKUP
}

// Metadata describing one admin-defined field on a core entity (Job, Candidate,
// Application, Offer, ...) or on a Custom Object. The *value* lives in that
// entity's `customFields Json` column — this table only describes shape and
// validation. `entityType` is validated at the service layer against
// src/lib/entity-registry.ts, not a DB foreign key, because core entities are
// not rows in a table.
model CustomFieldDefinition {
  id           String          @id @default(cuid())
  entityType   String
  key          String
  label        String
  fieldType    CustomFieldType
  isRequired   Boolean         @default(false)
  isActive     Boolean         @default(true)
  sortOrder    Int             @default(0)
  // DROPDOWN/MULTI_SELECT choices, LOOKUP target entityType, min/max/regex, etc.
  options      Json?
  defaultValue Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([entityType, key])
  @@index([entityType])
}

// Admin-defined entity (e.g. "Vendor", "Assessment Result") with no dedicated
// table. Deliberately NOT implemented as runtime DDL (no CREATE TABLE at
// request time) — an admin-triggered schema mutation is an operational and
// injection risk out of proportion to the benefit. Records are stored as JSON
// against a shared table instead; CustomFieldDefinition rows with
// entityType = CustomObjectDefinition.apiKey describe each object's fields.
model CustomObjectDefinition {
  id          String   @id @default(cuid())
  apiKey      String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  records CustomObjectRecord[]
}

model CustomObjectRecord {
  id           String   @id @default(cuid())
  definitionId String
  data         Json
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  definition CustomObjectDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  createdBy  User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  relations  CustomObjectRelation[]

  @@index([definitionId])
}

// Links a custom object record to a core entity (e.g. this "Assessment Result"
// record relates to Application #123). relatedEntityType is validated the same
// way as CustomFieldDefinition.entityType.
model CustomObjectRelation {
  id                String   @id @default(cuid())
  recordId          String
  relatedEntityType String
  relatedEntityId   String
  createdAt         DateTime @default(now())

  record CustomObjectRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([relatedEntityType, relatedEntityId])
  @@index([recordId])
}

// ---------------------------------------------------------------------------
// Audit log (§11.13, §13) — every configuration change and lifecycle action
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  // Namespaced action string, e.g. "role.created", "custom_field.updated".
  // Each module appends its own actions; see src/lib/audit/actions.ts.
  action     String
  entityType String
  entityId   String
  // { before, after } snapshot of changed fields only.
  changes    Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Module 2 — Requisition / Job Management (§11.1)
// ---------------------------------------------------------------------------

enum JobStatus {
  DRAFT
  PENDING_APPROVAL
  OPEN
  ON_HOLD
  CLOSED
  CANCELLED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum JobPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Job {
  id String @id @default(cuid())

  title                String
  departmentId         String
  locationId           String
  employmentType       EmploymentType
  priority             JobPriority
  status               JobStatus      @default(DRAFT)
  positionsCount       Int
  // Written only by the future Offer module (hire confirmed). No API route in
  // this module accepts a value for it — see src/lib/validations/job.ts.
  positionsFilledCount Int            @default(0)
  targetDate           DateTime?
  description          String?
  mustHaveCriteria     String[]       @default([])
  goodToHaveCriteria   String[]       @default([])

  customFields Json?

  // "One need splits into multiple roles" (§11.1) — intentionally unconstrained.
  parentJobId String?
  parentJob   Job?    @relation("JobParent", fields: [parentJobId], references: [id], onDelete: SetNull)
  childJobs   Job[]   @relation("JobParent")

  // Denormalized onto Job (in addition to the full list in
  // JobRecruiterAssignment) so every permission check and list-scope filter
  // is a plain column comparison instead of a join. Kept in sync with the
  // JobRecruiterAssignment.isPrimary row inside the same transaction —
  // see updateJobRecruiters in src/lib/services/jobs.ts. This is also the
  // sole ownership anchor for OWN/TEAM scope — the PRD's Job data model
  // (§9) names only "assigned recruiter(s)", so approval ownership resolves
  // against this same column rather than a separate hiring-manager field.
  primaryRecruiterId String
  primaryRecruiter   User   @relation("JobPrimaryRecruiter", fields: [primaryRecruiterId], references: [id])

  createdById String
  createdBy   User   @relation("JobCreatedBy", fields: [createdById], references: [id])

  // Optimistic locking: every update/transition must supply the version it
  // read. See ConflictError in src/lib/errors.ts.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department    ControlledListValue      @relation("JobDepartment", fields: [departmentId], references: [id])
  location      ControlledListValue      @relation("JobLocation", fields: [locationId], references: [id])
  recruiters    JobRecruiterAssignment[]
  statusChanges JobStatusChange[]

  pipelineStages PipelineStage[]
  applications   Application[]

  @@index([status])
  @@index([departmentId])
  @@index([locationId])
  @@index([parentJobId])
  @@index([primaryRecruiterId])
}

model JobRecruiterAssignment {
  jobId      String
  userId     String
  isPrimary  Boolean  @default(false)
  assignedAt DateTime @default(now())

  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([jobId, userId])
}

// A partial unique index enforcing "at most one primary recruiter per job" at
// the database level is added by hand in the generated migration (Prisma has
// no schema syntax for partial indexes as of this version):
//   CREATE UNIQUE INDEX "job_recruiter_one_primary"
//     ON "JobRecruiterAssignment" ("jobId") WHERE "isPrimary" = true;
// The service layer is still the primary enforcement (it validates exactly
// one isPrimary before writing); this index is the belt-and-suspenders
// backstop against a future bug or a raw SQL write bypassing the service.

model JobStatusChange {
  id         String    @id @default(cuid())
  jobId      String
  fromStatus JobStatus
  toStatus   JobStatus
  // Required by the service for HOLD/CLOSE/CANCEL, null for SUBMIT/APPROVE/
  // REJECT/RESUME. Points at a ControlledListValue in the
  // JOB_HOLD_REASON/JOB_CLOSE_REASON/JOB_CANCEL_REASON list matching toStatus.
  reasonId   String?
  note       String?
  actorId    String
  createdAt  DateTime  @default(now())

  job    Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  reason ControlledListValue? @relation(fields: [reasonId], references: [id])
  actor  User                 @relation(fields: [actorId], references: [id])

  @@index([jobId, createdAt])
}

// ---------------------------------------------------------------------------
// Module 3 — Candidate Database (§11.2)
// ---------------------------------------------------------------------------

// "A person, held once globally" (§9) — phone is the PRD's stated unique key;
// email is only a secondary signal for duplicate detection (see
// checkCandidateDuplicates in src/lib/services/candidates.ts), so it is not
// unique-constrained here.
model Candidate {
  id String @id @default(cuid())

  name                 String
  phone                String    @unique
  email                String?
  location             String?
  currentCompensation  Decimal?  @db.Decimal(12, 2)
  expectedCompensation Decimal?  @db.Decimal(12, 2)
  noticePeriodDays     Int?
  earliestAvailability DateTime?
  // §9 lists "experience" as its own Candidate field, distinct from the
  // detailed work-history entries §11.2 asks to store as "professional...
  // data" (below) — kept as two fields per the Phase 2 design.
  totalExperienceYears Decimal?  @db.Decimal(4, 1)
  skills               String[]  @default([])
  tags                 String[]  @default([])
  // Each entry: { company, title, startDate, endDate?, description? } —
  // shape validated by candidateCreateSchema, not DB-enforced (same pattern
  // as Job's customFields).
  experienceHistory    Json?
  // Each entry: { institution, degree, fieldOfStudy?, startYear?, endYear? }
  educationHistory     Json?
  // GDPR-aligned consent capture (§13, §9) — required at creation; there is
  // no "create without consent" path.
  consentGivenAt       DateTime

  customFields Json?

  sourceId String?
  source   ControlledListValue? @relation("CandidateSource", fields: [sourceId], references: [id])

  // Ownership anchor for OWN/TEAM permission scope, per the Phase 1 decision:
  // §9's Candidate has no "assigned recruiter" concept (that only exists once
  // the Application entity exists, in a future module), so scope resolves
  // against whoever created the record instead.
  createdById String
  createdBy   User   @relation("CandidateCreatedBy", fields: [createdById], references: [id])

  // Optimistic locking — purely internal, no user-facing surface, same
  // pattern as Job.version.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents    CandidateDocument[]
  notes        CandidateNote[]
  applications Application[]

  @@index([email])
  @@index([sourceId])
  @@index([createdById])
}

// Multi-document attachment (§11.2). `storageKey` is an opaque handle into
// whichever StorageProvider is configured (src/lib/storage) — never a raw
// filesystem path exposed to clients, so the backing store can change without
// touching this table.
model CandidateDocument {
  id             String   @id @default(cuid())
  candidateId    String
  documentTypeId String
  fileName       String
  mimeType       String
  fileSize       Int
  storageKey     String
  uploadedById   String
  uploadedAt     DateTime @default(now())

  candidate    Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  documentType ControlledListValue @relation("CandidateDocumentType", fields: [documentTypeId], references: [id])
  uploadedBy   User                @relation("CandidateDocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([candidateId])
}

// Team-visible comment feed for the candidate timeline (§11.2, §9). §9
// describes this category ("Task, Note, Activity") as an immutable audit
// log, so there is deliberately no update/delete on this model or its API —
// see src/lib/services/candidates.ts.
model CandidateNote {
  id          String   @id @default(cuid())
  candidateId String
  body        String
  authorId    String
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  author    User      @relation("CandidateNoteAuthor", fields: [authorId], references: [id])

  @@index([candidateId, createdAt])
}

// ---------------------------------------------------------------------------
// Module 4 — Applications / Candidate Pipeline (§11.4)
// ---------------------------------------------------------------------------

enum ApplicationOutcome {
  ACTIVE
  REJECTED
  WITHDRAWN
}

enum ApplicationEventType {
  STAGE_CHANGE
  REJECTED
  WITHDRAWN
}

enum EmailLogStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

// Configurable per job/pipeline (§10.1–10.2, §11.4) — deliberately not a
// Prisma enum (different jobs run different stage sets) and not a
// ControlledList (ControlledList is global and unordered; a job's pipeline
// needs its own per-job ordering). Never hard-deleted once referenced by an
// Application or ApplicationEvent (default onDelete: Restrict on those FKs)
// — "removing" a stage from a pipeline deactivates it instead, the same
// convention ControlledListValue already uses via isActive.
//
// Uniqueness on (jobId, name) is enforced only among ACTIVE stages — a
// hand-written partial unique index added by hand in the generated
// migration (Prisma has no schema syntax for partial indexes, same
// limitation as JobRecruiterAssignment's one-primary-recruiter index):
//   CREATE UNIQUE INDEX "pipeline_stage_active_name_unique"
//     ON "PipelineStage" ("jobId", "name") WHERE "isActive" = true;
// A full (unconditional) unique constraint here would permanently reserve a
// deactivated stage's name and block ever reusing it for a new active
// stage — the opposite of the "deactivate, don't delete" design intent.
model PipelineStage {
  id        String   @id @default(cuid())
  jobId     String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job          Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  applications Application[]
  eventsFrom   ApplicationEvent[] @relation("ApplicationEventFromStage")
  eventsTo     ApplicationEvent[] @relation("ApplicationEventToStage")

  @@index([jobId, sortOrder])
}

// "One candidate against one job, holding the pipeline stage" (§9).
// Deliberately no unique constraint on (candidateId, jobId) — re-applying is
// allowed, only warned about (§11.4) — see findDuplicateApplications in
// src/lib/services/applications.ts. candidateId/jobId carry no onDelete
// override (default Restrict): Candidate deletion is blocked by a
// service-layer check in deleteCandidate before it would ever hit this FK;
// Job has no delete endpoint at all.
model Application {
  id String @id @default(cuid())

  candidateId String
  jobId       String
  stageId     String
  ownerId     String

  // Rejected/Withdrawn are terminal outcomes orthogonal to stage, not two of
  // the admin-configurable stages themselves (Phase 2 decision) — stage
  // stays frozen at whatever it was when the outcome was set, and outcome is
  // never reset back to ACTIVE once written.
  outcome         ApplicationOutcome @default(ACTIVE)
  outcomeReasonId String?
  outcomeAt       DateTime?

  stageEnteredAt DateTime @default(now())
  customFields   Json?

  createdById String
  // Optimistic locking — same pattern as Job.version / Candidate.version.
  version     Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidate     Candidate            @relation(fields: [candidateId], references: [id])
  job           Job                  @relation(fields: [jobId], references: [id])
  stage         PipelineStage        @relation(fields: [stageId], references: [id])
  owner         User                 @relation("ApplicationOwner", fields: [ownerId], references: [id])
  createdBy     User                 @relation("ApplicationCreatedBy", fields: [createdById], references: [id])
  outcomeReason ControlledListValue? @relation("ApplicationOutcomeReason", fields: [outcomeReasonId], references: [id])

  events         ApplicationEvent[]
  emailLogs      ApplicationEmailLog[]
  interviews     Interview[]
  offers         Offer[]
  handoffRecords HandoffRecord[]

  @@index([candidateId])
  @@index([jobId])
  @@index([jobId, stageId])
  @@index([candidateId, jobId])
  @@index([ownerId])
  @@index([outcome])
}

// Immutable history row for every stage move and outcome change — modeled
// directly on JobStatusChange. STAGE_CHANGE events set both fromStageId and
// toStageId; REJECTED/WITHDRAWN events set only fromStageId (a snapshot of
// where the application was when it left the pipeline) plus a required
// reasonId.
model ApplicationEvent {
  id            String               @id @default(cuid())
  applicationId String
  type          ApplicationEventType
  fromStageId   String?
  toStageId     String?
  reasonId      String?
  note          String?
  actorId       String
  createdAt     DateTime             @default(now())

  application Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStage   PipelineStage?       @relation("ApplicationEventFromStage", fields: [fromStageId], references: [id])
  toStage     PipelineStage?       @relation("ApplicationEventToStage", fields: [toStageId], references: [id])
  reason      ControlledListValue? @relation("ApplicationEventReason", fields: [reasonId], references: [id])
  actor       User                 @relation(fields: [actorId], references: [id])

  @@index([applicationId, createdAt])
}

// Bulk-email "infrastructure only" (§11.4, Phase 2 decision): this module
// renders and records what would be sent, but never calls a real mail
// provider. Every row this module writes has status = PENDING; SENT/FAILED/
// CANCELLED are reserved for the future Communication Hub module to set once
// real delivery exists — same "field exists, only a later module writes
// non-default values" pattern as Job.positionsFilledCount.
model ApplicationEmailLog {
  id            String         @id @default(cuid())
  applicationId String
  toEmail       String
  subject       String
  body          String
  status        EmailLogStatus @default(PENDING)
  requestedById String
  requestedAt   DateTime       @default(now())
  sentAt        DateTime?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requestedBy User        @relation(fields: [requestedById], references: [id])

  @@index([applicationId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Module 5 — Interview Management (§11.5)
// ---------------------------------------------------------------------------

enum InterviewMode {
  ONSITE
  VIRTUAL
  PHONE
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum InterviewRecommendation {
  STRONG_YES
  YES
  NO
  STRONG_NO
}

// One scheduled session against one Application — not against Candidate or
// Job directly, since "which pipeline this interview belongs to" is exactly
// what Application already tracks (§9). Interview intentionally has no
// "outcome" of its own: the actual accept/reject/advance decision continues
// to be made through Application's existing transition endpoint (Module 4)
// using the collected feedback as decision support — this module only
// schedules sessions and records structured feedback, never the pipeline
// decision itself.
model Interview {
  id String @id @default(cuid())

  applicationId String

  // Free text, not a Controlled List or a PipelineStage-style config model —
  // "Technical Round 1", "HR Round", etc. vary too freely per job/team to be
  // worth a fixed vocabulary or a second admin-configurable list model this
  // early (cf. mustHaveCriteria's same free-text-list treatment on Job).
  roundName String

  mode     InterviewMode
  // Address for ONSITE, a meeting link for VIRTUAL, a phone number for
  // PHONE — one flexible free-text field rather than three mode-specific
  // columns, since exactly one is ever meaningful per interview.
  location String?

  scheduledAt     DateTime
  durationMinutes Int      @default(60)

  status               InterviewStatus      @default(SCHEDULED)
  cancellationReasonId String?
  cancellationReason   ControlledListValue? @relation("InterviewCancellationReason", fields: [cancellationReasonId], references: [id])

  notes String?

  customFields Json?

  // Ownership anchor for OWN/TEAM scope on the scheduling side (who booked
  // this interview) — mirrors Job.primaryRecruiterId / Application.ownerId.
  // A second, independent access path exists for the assigned interviewers
  // themselves (panelists) — see assertManageAccess / assertReadOrFeedbackAccess
  // in src/lib/services/interviews.ts.
  scheduledById String
  scheduledBy   User   @relation("InterviewScheduledBy", fields: [scheduledById], references: [id])

  // Optimistic locking — same pattern as Job.version / Application.version.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application         @relation(fields: [applicationId], references: [id])
  panelists   InterviewPanelist[]
  feedback    InterviewFeedback[]

  @@index([applicationId])
  @@index([scheduledById])
  @@index([status])
  @@index([scheduledAt])
}

// Which users are assigned to conduct an interview — modeled directly on
// JobRecruiterAssignment, minus isPrimary (the PRD names no "lead
// interviewer" concept, unlike Job's primary recruiter).
model InterviewPanelist {
  interviewId String
  userId      String
  assignedAt  DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([interviewId, userId])
  @@index([userId])
}

// One interviewer's structured feedback for one interview (§8: "Interviewer
// ... submits structured feedback"). Unique per (interview, interviewer) —
// an interviewer files one scorecard per interview, editable up until
// someone reads it as final; there is no separate "submitted" lock, matching
// how Application/Job/Candidate records stay mutable via version rather than
// becoming read-only after creation.
model InterviewFeedback {
  id            String @id @default(cuid())
  interviewId   String
  interviewerId String

  recommendation InterviewRecommendation
  // 1-5, validated at the service layer (not DB-constrained) — same
  // "shape validated by Zod, not DDL" convention as Candidate.totalExperienceYears.
  rating         Int?
  comments       String?

  version     Int      @default(0)
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer User      @relation("InterviewFeedbackInterviewer", fields: [interviewerId], references: [id])

  @@unique([interviewId, interviewerId])
  @@index([interviewId])
}

enum OfferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  EXTENDED
  ACCEPTED
  DECLINED
  REVOKED
}

enum OfferApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// One offer against one Application — same anchoring choice as Interview,
// for the same reason (§9: Application already tracks which pipeline this
// belongs to). An Application can have more than one Offer over its life
// (a declined/revoked offer followed by a revised one); "at most one
// non-terminal Offer per Application at a time" is checked in the service
// layer (createOffer) for a friendly error, backed by a hand-written
// partial unique index (not representable in schema.prisma — no
// partial-index syntax — so it's added directly in the generated
// migration, same pattern as JobRecruiterAssignment's one-primary-recruiter
// index and PipelineStage's active-name index):
//   CREATE UNIQUE INDEX "offer_one_active_per_application"
//     ON "Offer" ("applicationId")
//     WHERE "status" IN ('DRAFT', 'PENDING_APPROVAL', 'APPROVED', 'EXTENDED');
//
// Status is a fixed table-driven state machine (src/lib/offers/status-machine.ts),
// mirroring Job's — Offer's lifecycle (draft → submit → approve/reject →
// extend → accept/decline, plus revoke from anywhere non-terminal) is a
// true sequential workflow like Job's, unlike Interview's independent
// schedule/cancel/complete actions. No separate OfferStatusChange history
// table exists for the same reason Interview has no InterviewEvent table:
// `updatedAt` + `status` is enough for the transitions that are plain status
// flips (extend/accept/decline/revoke); the one transition rich enough to
// need its own record — the approval decision — gets OfferApproval below.
model Offer {
  id String @id @default(cuid())

  applicationId String

  // §9's compensation fields (Candidate.currentCompensation /
  // expectedCompensation) use this exact type — same convention, not a new one.
  compensation        Decimal   @db.Decimal(12, 2)
  expectedJoiningDate DateTime?

  notes String?

  customFields Json?

  status OfferStatus @default(DRAFT)

  // Shared between DECLINE and REVOKE — same "one outcome + one reason field"
  // choice Application makes for REJECTED/WITHDRAWN, rather than Job's
  // one-list-per-action split, since Decline/Revoke map onto Application's
  // reject/withdraw shape (terminal negative outcome, different actors, one
  // reason vocabulary) more closely than onto Job's per-situation lists.
  outcomeReasonId String?
  outcomeReason   ControlledListValue? @relation("OfferOutcomeReason", fields: [outcomeReasonId], references: [id])

  // Ownership anchor for OWN/TEAM scope — mirrors Job.primaryRecruiterId /
  // Interview.scheduledById. Offer has only this one ownership facet (no
  // panelist-style second actor), so access resolves through a single
  // assertOfferAccess function, the same shape as Job's assertJobAccess,
  // not Interview's two-function split.
  createdById String
  createdBy   User   @relation("OfferCreatedBy", fields: [createdById], references: [id])

  // Optimistic locking — same pattern as Job.version / Interview.version.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application   Application     @relation(fields: [applicationId], references: [id])
  approvals     OfferApproval[]
  handoffRecord HandoffRecord?

  @@index([applicationId])
  @@index([createdById])
  @@index([status])
}

// One row per approval attempt (created PENDING when an Offer is submitted,
// updated in place when decided) — an append-only history of approval
// attempts, not a single mutable "current approval" field, so a
// reject → revise → resubmit cycle keeps every prior attempt's outcome
// instead of overwriting it. `approverId` is null until someone actually
// decides it; any user holding OFFER:APPROVE may act on a PENDING row, so
// this isn't a pre-assigned reviewer, matching how Job's approval step
// doesn't pre-assign an approver either.
model OfferApproval {
  id      String @id @default(cuid())
  offerId String

  status OfferApprovalStatus @default(PENDING)

  approverId String?
  approver   User?     @relation("OfferApprovalApprover", fields: [approverId], references: [id])
  comments   String?
  decidedAt  DateTime?

  createdAt DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId])
}

enum HandoffStatus {
  PENDING
  DELIVERED
  ACCEPTED
  EXCEPTION
}

// Only STRUCTURED_EXPORT is ever written today — no real HRIS integration
// exists yet (§12), so src/lib/hris/ has exactly one provider, the same
// "field exists, only a later module writes the other value" pattern as
// EmailLogStatus / Job.positionsFilledCount. API_PUSH is here so a future
// real HRIS connector is a new provider implementation and a value this
// column already accepts, not a schema change.
enum HandoffDeliveryMethod {
  API_PUSH
  STRUCTURED_EXPORT
}

// Triggered by Offer's ACCEPT transition (src/lib/services/offers.ts), one
// handoff per accepted Offer — @unique on offerId rather than a modeled
// "at most one active handoff per application" rule like Offer's own,
// because Offer's status machine already guarantees at most one Offer per
// Application ever reaches ACCEPTED (every other terminal/non-terminal
// status is excluded from triggering a handoff at all).
//
// `payload` is a snapshot assembled once at creation (candidate profile +
// final offer terms + the candidate's document list), not a live join —
// same "render/capture once, store the result" choice as
// ApplicationEmailLog.subject/body, so what HR received stays stable even
// if the candidate record changes afterward. See buildHandoffPayload in
// src/lib/services/handoffs.ts.
//
// Lifecycle is a handful of named actions (retryHandoff, acknowledgeHandoff),
// not a table-driven state machine like Job/Offer — Handoff's shape (attempt
// delivery, retry on failure, get acknowledged) is closer to Interview's
// independent actions than to a long sequential workflow, so it doesn't
// warrant that abstraction (Phase 1 decision: don't over-engineer this).
//
// Acknowledgement reuses the existing global APPROVE permission action
// (HR/Onboarding is granted HANDOFF:APPROVE in prisma/seed.ts): confirming
// a handoff was received correctly is the same kind of gatekeeper decision
// Job/Offer's APPROVE already models, so this needed no new
// PermissionAction value.
//
// Once ACCEPTED, the linked Application becomes read-only: assertApplicationNotHandedOff
// (exported from src/lib/services/handoffs.ts) is called from
// transitionApplication, scheduleInterview, and createOffer so a hired-and-
// handed-off candidate's application can't be rejected/withdrawn/re-staged
// and can't collect a new interview or offer — no new field on Application
// itself, this table is the sole source of truth for "is this archived."
model HandoffRecord {
  id String @id @default(cuid())

  offerId       String @unique
  applicationId String

  status         HandoffStatus         @default(PENDING)
  deliveryMethod HandoffDeliveryMethod

  // Assembled once at creation — see the model comment above.
  payload Json

  // Set by a successful push/export attempt or left null for STRUCTURED_EXPORT,
  // which has no external system to hand back an id from.
  externalReferenceId String?
  // Free text, not a Controlled List — a delivery failure or an HR-flagged
  // data issue is too open-ended for a fixed vocabulary, same reasoning as
  // InterviewFeedback.comments / OfferApproval.comments.
  exceptionReason     String?

  customFields Json?

  // Who accepted the Offer that triggered this handoff — the ownership
  // anchor for OWN/TEAM scope, mirroring Offer.createdById.
  initiatedById String
  initiatedBy   User   @relation("HandoffInitiatedBy", fields: [initiatedById], references: [id])

  acknowledgedById String?
  acknowledgedBy   User?     @relation("HandoffAcknowledgedBy", fields: [acknowledgedById], references: [id])
  acknowledgedAt   DateTime?

  // Optimistic locking — same pattern as Offer.version / Interview.version.
  version Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offer       Offer                    @relation(fields: [offerId], references: [id])
  application Application              @relation(fields: [applicationId], references: [id])
  attempts    HandoffDeliveryAttempt[]

  @@index([applicationId])
  @@index([status])
  // OWN/TEAM-scope listHandoffs filters on initiatedById — same "index the
  // ownership column list queries scope against" precedent as
  // Offer.@@index([createdById]).
  @@index([initiatedById])
}

// One row per delivery attempt (the initial automatic attempt on ACCEPT,
// plus every manual retry) — an append-only history, same shape as
// OfferApproval: never overwritten, so a flaky first attempt's error
// stays visible even after a later retry succeeds.
model HandoffDeliveryAttempt {
  id              String @id @default(cuid())
  handoffRecordId String

  deliveryMethod      HandoffDeliveryMethod
  succeeded           Boolean
  externalReferenceId String?
  errorMessage        String?

  attemptedById String
  attemptedBy   User     @relation(fields: [attemptedById], references: [id])
  attemptedAt   DateTime @default(now())

  handoffRecord HandoffRecord @relation(fields: [handoffRecordId], references: [id], onDelete: Cascade)

  @@index([handoffRecordId])
}
